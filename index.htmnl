  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      background: #09212b;
      padding: 16px 8px 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Noto Sans TC', 'Noto Sans JP', sans-serif;
    }
    .map-stage {
      width: 100%;
      max-width: 1260px; /* 貼合 Surface Pro 3:2 螢幕橫向視野 */
      background-color: #BCE3EC; /* 陳又凌繪本經典粉天藍底色 */
      border-radius: 28px;
      padding: 32px 18px 44px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
      position: relative;
      overflow: hidden;
    }
    svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }
    .interactive-card {
      cursor: pointer;
      transition: opacity 0.2s ease, filter 0.2s ease;
    }
    .interactive-card:active {
      opacity: 0.9;
      filter: brightness(0.96);
    }
  </style>
</head>
<body>

<div class="map-stage">
  <svg viewBox="0 0 1200 2360">
    <defs>

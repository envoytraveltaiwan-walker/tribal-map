        <feDropShadow dx="0" dy="7" stdDeviation="6" flood-color="#0E4857" flood-opacity="0.25"/>
      </filter>
      <!-- 右下角大野宴市集陰影 -->
      <filter id="feast-shadow" x="-25%" y="-25%" width="150%" height="150%">
        <feDropShadow dx="2" dy="8" stdDeviation="5" flood-color="#3D2005" flood-opacity="0.3"/>
      </filter>
      <!-- 夕陽暖陽光暈 -->
      <radialGradient id="sun-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFA834" stop-opacity="0.95"/>
        <stop offset="45%" stop-color="#FF7B25" stop-opacity="0.5"/>
        <stop offset="100%" stop-color="#FF7B25" stop-opacity="0"/>

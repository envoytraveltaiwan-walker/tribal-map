    <!-- ==================== 8. 【新增：圖片下方八大部落圖騰說明與中日對照專區】 ==================== -->
    <g transform="translate(50, 1680)">
      <!-- 說明區外框 -->
      <rect x="0" y="0" width="1100" height="600" rx="20" fill="#FFFFFF" opacity="0.94" filter="url(#badge-shadow)"/>

      <!-- 區塊標題 -->
      <text x="40" y="50" font-size="28" font-weight="900" fill="#132438">八大原鄉部落文化圖騰與風土特色解說 ｜ 8大集落の文化トーテムと風土解説</text>
      <text x="40" y="76" font-size="14" font-weight="700" fill="#8C6B2D">EXPLORE INDIGENOUS TOTEMS, TRADITIONS & GASTRONOMY OF TAIWAN</text>
      <line x1="40" y1="92" x2="1060" y2="92" stroke="#E2E8F0" stroke-width="2"/>

      <!-- 第一列：北部與東部 (白蘭、樂水、布拉旦、織羅) -->
      <!-- 1. 白蘭部落 -->
      <g transform="translate(40, 120)">
        <polygon points="16,0 32,16 16,32 0,16" fill="#A62122"/>
        <circle cx="16" cy="16" r="4" fill="#FFF"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">白蘭部落 BAILAN（バイラン）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#D90429">【泰雅族】祖靈之眼雙菱紋 ✕ 原生馬告 ✕ 櫻花</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">祖靈之眼象徵祖先叮嚀庇佑；原生馬告帶有檸檬香氣。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">祖霊の瞳は保護を意味し、馬告はレモン香る原生スパイス。</text>
      </g>

      <!-- 2. 樂水部落 -->
      <g transform="translate(560, 120)">
        <rect x="0" y="6" width="30" height="18" rx="4" fill="#4F772D"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">樂水部落 LESHUI（ロースイ）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#2A9D8F">【泰雅族】青竹獵人便當 ✕ 山林刺蔥</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">以新鮮竹筒盛裝山胡椒鹹豬肉與糯米，山林智慧結晶。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">新鮮な竹に包まれた伝統の狩人飯と山菜カラスザンショウ。</text>
      </g>

      <!-- 3. 布拉旦部落 -->
      <g transform="translate(40, 230)">
        <path d="M 0 24 C 8 8, 24 8, 32 24" stroke="#E63946" stroke-width="4" fill="none"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">布拉旦 PRATAN（プラタン）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#E76F51">【太魯閣族】彩虹之橋神話 ✕ 原木獵弓</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">象徵通過考驗通往祖靈之境的彩虹橋，守護純淨溪谷。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">試練を越えて祖霊へ渡る「虹の架け橋」伝説と清らかな峡谷。</text>
      </g>

      <!-- 4. 織羅部落 -->
      <g transform="translate(560, 230)">
        <polygon points="16,0 20,11 32,16 20,21 16,32 12,21 0,16 12,11" fill="#E63946"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">織羅部落 CEROH（ツェロー）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#E63946">【阿美族】八角太陽星圖騰 ✕ 彩繪米大地餐桌</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">象徵母親與生命光芒的八角星，秀姑巒溪五彩米傳奇。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">母なる太陽を象徴する八角星と五色米のアートブレッド。</text>
      </g>

      <line x1="40" y1="335" x2="1060" y2="335" stroke="#E2E8F0" stroke-width="1.5"/>

      <!-- 第二列：南部與東南 (永康、鸞山、禮納里、吾拉魯滋) -->
      <!-- 5. 永康部落 -->
      <g transform="translate(40, 360)">
        <circle cx="16" cy="16" r="14" fill="#FAF8F5" stroke="#582F0E" stroke-width="3"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">永康部落 YONGKANG（ヨンカン）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#2A6F97">【布農族】歲時祭曆木刻圖騰 ✕ 星空野宴柴燒火堆</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">全世界珍稀的原民木刻板曆文字，獵人星空下的野性餐桌。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">世界唯一の木刻暦文字とブヌン族の満天星空ジビエBBQ。</text>
      </g>

      <!-- 6. 鸞山部落 -->
      <g transform="translate(560, 360)">
        <circle cx="16" cy="16" r="14" fill="#2D6A4F"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">鸞山部落 SAZA（サザ）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#2D6A4F">【布農族】會走路的百年榕樹 ✕ 木臼現搗小米麻糬</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">無圍牆森林博物館，千歲白榕氣根漫延，手搗熱騰騰麻糬。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">巨大な歩くガジュマル樹海と伝統の餅つき文化体験。</text>
      </g>

      <!-- 7. 禮納里部落 -->
      <g transform="translate(40, 470)">
        <path d="M 8 6 L 16 0 L 24 6 L 16 20 Z" fill="#FFFFFF" stroke="#8C6B2D" stroke-width="2"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">禮納里 RINARI（リナリ）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#9D0208">【排灣族/魯凱族】百合聖花 ✕ 琉璃珠 ✕ 石板建築</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">百合象徵女性純潔與勇士榮耀，台灣山中普羅旺斯。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">高貴な百合の聖花とトンボ玉。台湾のプロヴァンスと称される里。</text>
      </g>

      <!-- 8. 吾拉魯滋部落 -->
      <g transform="translate(560, 470)">
        <ellipse cx="14" cy="14" rx="8" ry="12" fill="#3D1E06"/>
        <text x="42" y="18" font-size="17" font-weight="900" fill="#132438">吾拉魯滋 ULALJUC（ウラルツ）</text>
        <text x="42" y="36" font-size="12.5" font-weight="700" fill="#6F4E37">【排灣族】百步蛇紋雙耳陶壺 ✕ 大武山手烘咖啡</text>
        <text x="42" y="54" font-size="12" font-weight="500" fill="#4B5563">神聖百步蛇護佑之古陶壺；北大武山甘醇有機高山咖啡。</text>
        <text x="42" y="70" font-size="11.5" font-weight="500" fill="#6B7280">百歩蛇の神聖な陶壺と大武山の恵みを受けた極上アラビカ珈琲。</text>
      </g>
    </g>

    <!-- ==================== 9. 底部展場大字版權頁尾 ==================== -->
    <g transform="translate(50, 2320)">
      <text x="0" y="0" font-size="28" font-weight="900" fill="#132438" letter-spacing="2">走進山海間 ‧ 探訪八大原住民族部落</text>
      <text x="0" y="26" font-size="14.5" font-weight="700" fill="#8C6B2D" letter-spacing="1">TAIWAN INDIGENOUS TRIBAL TOURS ‧ ENVOY TRAVEL ‧ CIP OFFICIAL CERTIFIED</text>
    </g>
  </svg>
</div>

</body>
</html>

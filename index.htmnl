        </svg>
        <text x="56" y="28" font-size="20" font-weight="900" fill="#132438" letter-spacing="1">ENVOY TRAVEL 安捷國際旅行社</text>
        <text x="56" y="52" font-size="13.5" font-weight="700" fill="#8C6B2D">交通部觀光署甲種旅行業 註冊編號 5920 號 ｜ 品保協會會員</text>
      </g>

      <!-- 行政院原住民族委員會 CIP 官方推薦標章 -->
      <g transform="translate(480, 0)" class="interactive-card" onclick="trackMapInteraction('click_cip_logo', 'Brand', 'CIP_Official');">

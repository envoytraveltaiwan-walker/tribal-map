      <filter id="mega-pop" x="-35%" y="-35%" width="170%" height="170%">
        <feDropShadow dx="3" dy="12" stdDeviation="7" flood-color="#0F333E" flood-opacity="0.35"/>
      </filter>
      <!-- 三語膠囊卡片立體陰影 -->
